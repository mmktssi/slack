# =========================================================
#  環境変数テンプレート（このファイルは共有してOK）
#  使い方: このファイルをコピーして「.env」を作り、実際の値を入れてください
#  ※ .env には本物の値を書き、Git等で共有しないこと
# =========================================================

# ---- 自分のプロフィール ----
MY_NAME=
MY_TITLE=
MY_EMAIL=
MY_PHONE=

# ---- 会社・部署 ----
COMPANY_NAME=
DEPARTMENT=

# ---- Supabase ----
# プロジェクトのURL（例: https://abcdefgh.supabase.co）
SUPABASE_URL=
# anon / publishable キー（ブラウザで使ってよい公開用キー）
SUPABASE_ANON_KEY=
# service_role / secret キー（管理者権限。ブラウザやapp.jsには絶対に入れない）
SUPABASE_SERVICE_ROLE_KEY=
# 個人アクセストークン（sbp_ で始まるもの。= のすぐ後ろに貼り付け）
SUPABASE_ACCESS_TOKEN=
